# Required: Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Required: GitHub token with Copilot access, used by the Copilot CLI in the
# container (fine-grained PAT with "Copilot Requests" or a gh OAuth token).
COPILOT_GITHUB_TOKEN=your_github_token

# Required: Discord IDs (decimal snowflakes).
DISCORD_GUILD_ID=your_guild_id
DISCORD_CHANNEL_ID=your_trigger_channel_id
DISCORD_USER_ID=your_operator_user_id
DISCORD_ROLE_ID=your_trigger_role_id

# Optional: when true, Copilot runs with --allow-all (no tool/path/URL prompts).
BROKER_COPILOT_ALLOW_ALL=true

# Optional overrides (container defaults shown).
#BROKER_STATE_DIR=/data/state
#BROKER_DEFAULT_CWD=/workspace
#COPILOT_BIN=/usr/local/bin/copilot
#BROKER_MAX_SESSIONS=3
#BROKER_ATTACHMENT_MAX_BYTES=10485760
#BROKER_ATTACHMENT_MAX_COUNT=5
#BROKER_LOG_LEVEL=info
